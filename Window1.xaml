<Window x:Class="Lab5_ZPO.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5_ZPO"
        mc:Ignorable="d"
        
        Icon="images/app_icon.png"
        Title="" Height="Auto" Width="Auto" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="Black">
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" ShowGridLines="False" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Label x:Name="imieLabel" Content="Imię:" FontSize="14" FontWeight="Bold" Foreground="White" 
               HorizontalAlignment="Left" Height="30" Grid.Column="0" Grid.Row="0" Margin="5" />
        <TextBox x:Name="imieTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                 Width="190" Grid.ColumnSpan="2" Grid.RowSpan="1" Margin="5" />

        <Label x:Name="nazwiskoLabel" Content="Nazwisko:" FontSize="14" FontWeight="Bold" Foreground="White"
               HorizontalAlignment="Left" Height="30" Grid.Column="0" Grid.Row="1" Margin="5" />
        <TextBox x:Name="nazwiskoTextBox" Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                 Width="190" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="1" Margin="5" />

        <Label x:Name="phoneNumberLabel" Content="Numer tel.:" FontSize="14" FontWeight="Bold" Foreground="White"
               HorizontalAlignment="Left" Height="30" Grid.Column="0" Grid.Row="2" Margin="5" />
        <TextBox x:Name="phoneNumerTextBox" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Stretch" 
                 PreviewTextInput="PhoneNumberTextBox_PreviewTextInput" 
                 PreviewKeyDown="PhoneNumberTextBox_PreviewKeyDown" 
                 DataObject.Pasting="PhoneNumberTextBox_Pasting"
                 Width="190" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="1" Margin="5" />

        <Label x:Name="emailLabel" Content="E-mail:" FontSize="14" FontWeight="Bold" Foreground="White"
               HorizontalAlignment="Left" Height="30" Grid.Column="0" Grid.Row="3" Margin="5" />
        <TextBox x:Name="emailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                 Width="190" Grid.Row="3" Grid.ColumnSpan="2" Grid.RowSpan="1" Margin="5" />

        <Label x:Name="traitsLabel" Content="Kategoria:" FontSize="14" FontWeight="Bold" Foreground="White"
               HorizontalAlignment="Left" Height="30" Grid.Column="0" Grid.Row="4" Margin="5" />
        <ComboBox x:Name="traitsComboBox" SelectedValue="{Binding Trait, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"
                  VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Width="190" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="1" Margin="5" >
            <ComboBoxItem Content="Rodzina"/>
            <ComboBoxItem Content="Znajomi"/>
            <ComboBoxItem Content="Praca"/>
            <ComboBoxItem Content="Inne"/>
        </ComboBox>

        <Button x:Name="addButtonWindow" Content="Dodaj" BorderThickness="3" BorderBrush="White" Background="Black" Foreground="White"
                HorizontalAlignment="Center" Height="45" Width="120" Grid.Row="5" Margin="4" Click="addButtonWindow_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                </Style>
            </Button.Resources>
        </Button>

        <Button x:Name="cancelButtonWindow" Content="Anuluj" BorderThickness="3" BorderBrush="White" Background="Black" Foreground="White"
                HorizontalAlignment="Center" Height="45" Width="120" Grid.Column="1" Grid.Row="5" Margin="4" Click="cancelButtonWindow_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
